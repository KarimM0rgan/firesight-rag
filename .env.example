# ── Generation model ───────────────────────────────────────────────────────
# Provider: "anthropic" or "openai"
FIRESIGHT_LLM_PROVIDER=anthropic
FIRESIGHT_LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Local paths (absolute or relative to repo root) ────────────────────────
FIRESIGHT_DUCKDB_PATH=data/processed/firesight.duckdb
FIRESIGHT_CHROMA_PATH=data/processed/chroma
FIRESIGHT_DOCS_PATH=data/raw/documents

# Source data — see data/PROFILE.md for how to obtain these
FIRESIGHT_NFIRS_DIR=E:/Easter 26/CS444/Data Analysis Project/nfirs comparison
FIRESIGHT_LOCAL_INCIDENTS=E:/Easter 26/CS444/Data Analysis Project/sewanee-incidents.json

# ── Retrieval ──────────────────────────────────────────────────────────────
FIRESIGHT_EMBED_MODEL=BAAI/bge-small-en-v1.5
FIRESIGHT_RERANK_MODEL=BAAI/bge-reranker-base
FIRESIGHT_TOP_K=5

# ── Guardrails ─────────────────────────────────────────────────────────────
FIRESIGHT_SQL_TIMEOUT_S=15
FIRESIGHT_SQL_ROW_LIMIT=1000
FIRESIGHT_EVAL_MAX_QUESTIONS=60
FIRESIGHT_EVAL_MAX_USD=2.00
